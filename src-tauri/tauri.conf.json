{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COD Camo Tracker",
  "version": "0.2.0",
  "identifier": "com.jay.codcamotracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "COD Camo Tracker",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 240,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2MURFOUM0QTZDNzE1MzIKUldReUZjZW14T2tkdGpUUlI0WXEyNVZmM2xPNU5YcWsxbW80Um01QlUzZm5lL0hWU3U4RUdHYXgK",
      "endpoints": [
        "https://github.com/CodeWriter-Jay/cod-camo-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
